# Bloqueia acesso direto a arquivos internos do protótipo
<FilesMatch "^(config(\.example)?\.php|terminal\.php|LEIAME\.md|INSTALACAO\.md|mock-claude\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|clinica|dados|testes)(/|$) - [F,L]
</IfModule>
