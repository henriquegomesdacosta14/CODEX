# Três Encontros
Options -Indexes
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
